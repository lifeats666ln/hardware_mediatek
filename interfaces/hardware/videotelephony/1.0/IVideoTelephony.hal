package vendor.mediatek.hardware.videotelephony@1.0;

interface IVideoTelephony {
    enum EventFlagBits : uint32_t {
        FMQ_NOT_EMPTY = 1 << 0,
        FMQ_NOT_FULL = 1 << 1,
    };

    configureFmqMode(uint16_t mode) generates (uint16_t retval);

    configureFmqSyncRead() generates (bool ret, fmq_sync<uint8_t> mqDesc);

    configureFmqSyncWrite() generates (bool ret, fmq_sync<uint8_t> mqDesc);
};
